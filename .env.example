# Fine-grained token, restricted to the repository you want to edit.
# Repository permission: Contents -> Read and write.
GITHUB_TOKEN=github_pat_REPLACE_ME

# Default: OpenAI-compatible Chat Completions API.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=REPLACE_ME
AI_MODEL=gpt-4.1-mini
# Set to 0 if your local model doesn't implement JSON response_format.
AI_JSON_MODE=1

# Local development: only accessible on this computer.
HOST=127.0.0.1
PORT=8787

# For remote access set HOST=0.0.0.0 and APP_PASSWORD to a long random password.
# Always put a remote deployment behind HTTPS and preferably SSO/VPN.
# APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Only needed if frontend is hosted on GitHub Pages, e.g. https://koenvanwijk.github.io
# Exact origin (scheme + host, without path). Keep empty for local-only use.
CORS_ALLOWED_ORIGIN=
