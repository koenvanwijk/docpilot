{
  "name": "DocPilot — GitHub Markdown Agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "DocPilot editor",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm test",
  "postStartCommand": "bash scripts/start-codespaces.sh",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
